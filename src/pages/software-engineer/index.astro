---
import { getCollection } from "astro:content";
import ProfilePage from "../../layouts/ProfilePage/ProfilePage.astro";
import type {
  ProfileLink,
  ProfileDomain,
  ProfileCompany,
  ProfilePosition,
  ProfileArticle,
  ProfileSection,
  ProfileUpdate,
  ProfileEducation,
  ProfileTechCategory,
} from "../../layouts/ProfilePage/ProfilePage.astro";

const allProjects = await getCollection("engineeringProjects");
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);

const companyOrder = ["GitLab", "Jobber", "Shopify"] as const;

const companyMeta: Record<
  (typeof companyOrder)[number],
  Pick<ProfileCompany, "role" | "dates" | "description" | "comingSoon">
> = {
  GitLab: {
    role: "Software Engineer II",
    dates: "May 2025 – Present",
    description:
      "Member of the Authorization team, responsible for GitLab's access control systems and permission infrastructure across the entire platform.",
    comingSoon: true,
  },
  Shopify: {
    role: "Software Engineer",
    dates: "2021 – 2023",
    description: `Focused on developer-facing products, specifically on the <a href="https://www.youtube.com/watch?v=je6vfmO6Hp0" target="_blank" rel="noopener noreferrer">Flow</a> team, contributing to a tool automating millions of tasks within Shopify stores.`,
  },
  Jobber: {
    role: "Software Engineer II",
    dates: "2023 – 2025",
    description:
      "Focused on platform work across Jobber's field service management product.",
  },
};

const companies: ProfileSection<ProfileCompany> = {
  title: "Work",
  items: companyOrder.map((name) => ({
    name,
    logoSrc: `/images/companies/${name.toLowerCase()}.png`,
    ...companyMeta[name],
    projects: sorted
      .filter((p) => p.data.company === name)
      .map((p) => ({
        title: p.data.title,
        description: p.data.description,
        href: p.data.externalHref ?? `/engineering/${p.slug}`,
      })),
  })),
};


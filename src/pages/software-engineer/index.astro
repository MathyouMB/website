---

<ProfilePage
  title="Engineering | Matthew MacRae-Bovell"
  description="Software engineering portfolio: A builder at heart, I design and ship developer-facing systems at scale. I care deeply about developer experience, systems thinking, and the craft of constructing reliable systems with agentic best practices."
  name="Matthew MacRae-Bovell"
  role="Impact-Driven Software Engineer"
  bio="A <span class='ProfilePage__keyword'>builder</span> at heart, I design and ship <span class='ProfilePage__keyword'>developer-facing systems</span> at scale. I care deeply about <span class='ProfilePage__keyword'>developer experience</span>, <span class='ProfilePage__keyword'>systems thinking</span>, and the craft of constructing <span class='ProfilePage__keyword'>reliable</span> systems with <span class='ProfilePage__keyword'>agentic best practices</span>."
  photoSrc="/images/me2.jpeg"
  links={links}
  currentPosition={currentPosition}
  updates={updates}
  latestArticle={articles.items[0]}
  freelanceOpen
  freelanceAvailability="Availability permitting"
  domains={domains}
  expertise={expertise}
  companies={companies}
  articles={articles}
  techStack={techStack}
/>

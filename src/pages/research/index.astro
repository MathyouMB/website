---
import Main from "../../layouts/Main/Main.astro";
import "./research.scss";
---

<Main
  title="Research | Matthew MacRae-Bovell"
  description="CS researcher at Carleton University's School of Computer Science, working on software usability, human-centered design, and agentic systems."
  styleOverride="background-color: lab(98.2539% -.108749 -.74997);"
>
  <div class="Research">
    <!-- ── Hero ── -->
    <section class="Research__hero">
      <div class="Research__heroGlows" aria-hidden="true">
        <div class="Research__glow Research__glow--a"></div>
        <div class="Research__glow Research__glow--b"></div>
      </div>

      <div class="Research__heroContent">
        <div class="Research__heroTop">
          <img
            class="Research__photo"
            src="/images/me2.jpeg"
            alt="Matthew MacRae-Bovell"
          />
          <div class="Research__heroIdentity">
            <h1 class="Research__name">Matthew<br />MacRae-Bovell</h1>

            <div class="Research__links">
              <a class="Research__iconLink" href="/" aria-label="Website">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  style="fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path
                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                  ></path>
                </svg>
              </a>
              <a
                class="Research__iconLink"
                href="https://github.com/MathyouMB"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                  ></path>
                </svg>
              </a>
              <a
                class="Research__iconLink"
                href="https://linkedin.com/in/matthewmacraebovell"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </svg>
              </a>
              <a
                class="Research__iconLink"
                href="mailto:matthewmacraebovell@outlook.com"
                aria-label="Email"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M0 4a2 2 0 0 1 2-2h20a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2 0v.217l10 6.668 10-6.668V4H2zm20 2.383-9.447 6.298a1 1 0 0 1-1.106 0L2 6.383V20h20V6.383z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <p class="Research__bio">
          A <span class="Research__keyword">software engineer</span> and researcher
          affiliated with Carleton University's <span class="Research__keyword"
            >School of Computer Science</span
          >, where I completed my undergraduate degree in Computer Science. My
          research explores how <span class="Research__keyword"
            >agentic AI systems</span
          > reshape how people build and interact with software, and what that means
          for <span class="Research__keyword">usability</span>, <span
            class="Research__keyword">developer workflows</span
          >, and <span class="Research__keyword">agent trust</span>.
        </p>
      </div>
    </section>

    <!-- ── Body ── -->
    <div class="Research__body">
      <!-- Affiliation -->
      <a
        class="Research__affiliation"
        href="https://carleton.ca/scs/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="Research__affiliationLogo"
          src="/images/schools/carleton2.jpg"
          alt="Carleton University"
        />
        <div class="Research__affiliationText">
          <span class="Research__affiliationLabel">Affiliation</span>
          <span class="Research__affiliationName"
            >School of Computer Science</span
          >
          <span class="Research__affiliationSub"
            >Carleton University · Ottawa, ON</span
          >
        </div>
        <span class="Research__affiliationArrow" aria-hidden="true">→</span>
      </a>

      <!-- Research Interests -->
      <section class="Research__section">
        <div class="Research__sectionHeader">
          <h3>Research Interests</h3>
          <div class="Research__rule"></div>
        </div>
        <div class="Research__pills">
          {
            [
              {
                label: "Agentic Software Engineering",
                icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
              },
              {
                label: "Computer-Using Agents",
                icon: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
              },
              {
                label: "Agent Trust & Safety",
                icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
              },
              {
                label: "Multiagent Orchestration",
                icon: `<circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v4M12 11l-5.5 6M12 11l5.5 6"/>`,
              },
              {
                label: "Software Usability",
                icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
              },
              {
                label: "Human-Centered Design",
                icon: `<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>`,
              },
            ].map((item) => (
              <span class="Research__pill">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                {item.label}
              </span>
            ))
          }
        </div>
      </section>

      <!-- About -->
      <section class="Research__section">
        <div class="Research__sectionHeader">
          <h3>About My Research</h3>
          <div class="Research__rule"></div>
        </div>
        <p class="Research__prose">
          My research sits at the intersection of agentic AI and human
          experience. Specifically, I study how autonomous systems
          (computer-using agents, agentic pipelines, multi-agent orchestration)
          reshape how people build and interact with software, and what that
          means for usability, developer workflows, and the security and
          authorization challenges that emerge when agents act on behalf of
          users.
        </p>
      </section>

      <!-- Publications & Projects -->
      <section class="Research__section">
        <div class="Research__sectionHeader">
          <h3>Publications &amp; Projects</h3>
          <div class="Research__rule"></div>
        </div>
        <div class="Research__pubList">
          <a
            class="Research__pubRow"
            href="https://conf.researchr.org/home/fse-2026"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="Research__pubBody">
              <span class="Research__pubKind Research__pubKind--publication"
                >Publication</span
              >
              <span class="Research__pubTitle"
                >Declarative Test-Native Software Fault Injection</span
              >
              <span class="Research__pubAuthors">Matthew MacRae-Bovell</span>
              <span class="Research__pubVenue">In Proceedings of FSE 2026</span>
            </div>
            <span class="Research__pubArrow" aria-hidden="true">→</span>
          </a>
          <a
            class="Research__pubRow"
            href="https://science.carleton.ca/data-day/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="Research__pubBody">
              <span class="Research__pubKind Research__pubKind--project"
                >Project</span
              >
              <span class="Research__pubTitle"
                >Evaluating Emoji Semantics: A Comparison of Computational
                Embeddings and Human Valence Judgements</span
              >
              <span class="Research__pubAuthors"
                >Peggy Liaw, Tal Friedman, Matthew MacRae-Bovell</span
              >
              <span class="Research__pubVenue">Carleton Data Day 12</span>
            </div>
            <span class="Research__pubArrow" aria-hidden="true">→</span>
          </a>
          <div class="Research__pubComingSoon">More coming soon</div>
        </div>
      </section>
    </div>
  </div>
</Main>

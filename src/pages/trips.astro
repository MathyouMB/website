---
import { getCollection } from "astro:content";
import Main from "../layouts/Main/Main.astro";
import "./trips.scss";

const allTrips = await getCollection("trips");
const trips = allTrips.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const uniqueCountries = new Set(trips.map((t) => t.data.country)).size;

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    timeZone: "UTC",
  });

const mapPins = trips.flatMap((t) =>
  t.data.locations.map((loc: { name: string; lat: number; lng: number }) => ({
    slug: t.slug,
    title: t.data.title,
    location: loc.name,
    lat: loc.lat,
    lng: loc.lng,
  })),
);
---

<Main
  title="Adventures | Matthew MacRae-Bovell"
  description={`${trips.length} trips across ${uniqueCountries} countries.`}
  styleOverride="background-color: lab(98.2539% -.108749 -.74997);"
>
  <div class="Trips">
    <!-- Hero -->
    <section class="Trips__hero">
      <div class="Trips__heroGlows" aria-hidden="true">
        <div class="Trips__glow Trips__glow--a"></div>
        <div class="Trips__glow Trips__glow--b"></div>
      </div>
      <div class="Trips__heroContent">
        <div class="Trips__heroMeta">Adventures</div>
        <h1 class="Trips__heading">The world,<br />one trip at a time.</h1>
        <p class="Trips__subtext">
          Exploring the world, one trip at a time — and counting.
        </p>
      </div>
    </section>

    <!-- Body -->
    <section class="Trips__body">
      <div class="Trips__mapWrap">
        <div id="trips-map" class="Trips__map" aria-label="Map of trips"></div>
      </div>

      <div class="Trips__grid">
        {
          trips.map((trip) => (
            <article
              id={`trip-${trip.slug}`}
              class="Trips__card"
              data-slug={trip.slug}
            >
              <div class="Trips__cardImgWrap">
                <img
                  class="Trips__cardImg"
                  src={trip.data.image}
                  alt={trip.data.title}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="Trips__cardBody">
                <span class="Trips__cardLocation">
                  {trip.data.locations
                    .map((l: { name: string }) => l.name)
                    .join(" · ")}
                </span>
                <h2 class="Trips__cardTitle">{trip.data.title}</h2>
                <time
                  class="Trips__cardDate"
                  datetime={trip.data.date.toISOString()}
                >
                  {fmtDate(trip.data.date)}
                </time>
                <p class="Trips__cardDesc">{trip.data.description}</p>
                {trip.data.tags.length > 0 && (
                  <ul class="Trips__cardTags" aria-label="Tags">
                    {trip.data.tags.map((tag: string) => (
                      <li class="Trips__cardTag">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Main>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script is:inline define:vars={{ mapPins }}>
  // Card entrance animations
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const cards = document.querySelectorAll(".Trips__card");

  if (prefersReducedMotion) {
    cards.forEach((card) => card.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
    );
    cards.forEach((card) => io.observe(card));
  }

  // Load Leaflet dynamically (safe for Astro SSG — avoids window access at build time)
  const script = document.createElement("script");
  script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
  script.onload = () => initMap();
  document.head.appendChild(script);

  function initMap() {
    const L = window.L;
    const worldBounds = L.latLngBounds(L.latLng(-90, -180), L.latLng(90, 180));
    const map = L.map("trips-map", {
      scrollWheelZoom: false,
      maxBounds: worldBounds,
      maxBoundsViscosity: 1.0,
      minZoom: 2,
    });

    L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: "abcd",
        maxZoom: 19,
        noWrap: true,
      },
    ).addTo(map);

    const dotIcon = L.divIcon({
      className: "",
      html: `<span class="Trips__pin" aria-hidden="true"></span>`,
      iconSize: [16, 16],
      iconAnchor: [8, 8],
      popupAnchor: [0, -14],
    });

    const markers = [];
    mapPins.forEach((pin) => {
      const marker = L.marker([pin.lat, pin.lng], { icon: dotIcon })
        .addTo(map)
        .bindPopup(
          `<strong class="Trips__popupTitle">${pin.title}</strong><br/><span class="Trips__popupLocation">${pin.location}</span>`,
          { className: "Trips__popup", closeButton: false },
        );

      marker.on("click", () => {
        const card = document.getElementById(`trip-${pin.slug}`);
        if (card) {
          card.scrollIntoView({ behavior: "smooth", block: "center" });
          card.classList.remove("is-highlighted");
          void card.offsetWidth; // force reflow to restart animation
          card.classList.add("is-highlighted");
          setTimeout(() => card.classList.remove("is-highlighted"), 1800);
        }
      });

      markers.push(marker);
    });

    if (markers.length > 0) {
      const group = L.featureGroup(markers);
      map.fitBounds(group.getBounds().pad(0.15), { maxZoom: 6 });
    } else {
      map.setView([20, 0], 2);
    }
  }
</script>

---
import Layout from "../Layout.astro";
import "./Main.scss";

interface Props {
  title: string;
  description?: string;
  imageUrl?: string;
  styleOverride?: string;
  hideNav?: boolean;
}

const { title, description, imageUrl, styleOverride, hideNav } = Astro.props;
---

<Layout
  title={title}
  description={description}
  imageUrl={imageUrl}
  styleOverride={styleOverride}
>
  {
    !hideNav && (
      <div class="Navbar">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/presentations">Talks</a>
        <a href="/projects">Projects</a>
      </div>
    )
  }
  <slot />
  <!-- <footer class="Footer">
    <p>© {currentYear} Matthew MacRae Bovell</p>
  </footer> -->
</Layout>

---
import Layout from "../Layout.astro";
import Navbar from "../../components/Navbar/Navbar.astro";
import "./Main.scss";

interface Props {
  title: string;
  description?: string;
  imageUrl?: string;
  styleOverride?: string;
  hideNav?: boolean;
  overlayNav?: boolean;
}

const { title, description, imageUrl, styleOverride, hideNav, overlayNav } =
  Astro.props;
---

<Layout
  title={title}
  description={description}
  imageUrl={imageUrl}
  styleOverride={styleOverride}
>
  {!hideNav && <Navbar overlay={overlayNav} />}
  <slot />
  <!-- <footer class="Footer">
    <p>© {currentYear} Matthew MacRae Bovell</p>
  </footer> -->
</Layout>
